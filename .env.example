# ================================
# DATABASE CONFIGURATION
# ================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=field-project
DB_USER=root
DB_PASSWORD=

# ================================
# JWT CONFIGURATION
# ================================
JWT_SECRET_KEY=change-this-to-random-string
JWT_EXPIRY_HOURS=24

# ================================
# FLASK CONFIGURATION
# ================================
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000
SECRET_KEY=change-this-to-another-random-string

# ================================
# PRODUCTION DATABASE (Neon/RDS)
# ================================
# Uncomment below when deploying
# DATABASE_URL=postgresql://user:pass@host/dbname

# ================================
# CORS
# ================================
FRONTEND_URL=http://localhost:5500

# ================================
# AI FORECASTING
# ================================
MODEL_PATH=ai/model.pkl